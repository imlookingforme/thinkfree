# ThinkFree Environment Configuration

# Environment mode: development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API & Server
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security & Session Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=thinkfree_super_secret_jwt_signing_key_replace_for_production_32chars
SESSION_COOKIE_NAME=thinkfree_session
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# PostgreSQL Database
POSTGRES_USER=thinkfree
POSTGRES_PASSWORD=thinkfree_secure_password
POSTGRES_DB=thinkfree_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://thinkfree:thinkfree_secure_password@postgres:5432/thinkfree_db

# Redis Cache & Session Timers
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# LLM Provider Configuration: gemini | openai | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Code Execution Engine: judge0 | subprocess
CODERUNNER_ADAPTER=judge0
JUDGE0_URL=http://judge0-server:2358

# Speech-to-Text Transcription (Validation Mode)
WHISPER_MODEL_SIZE=base.en
AUDIO_RETENTION_DAYS=30
ALLOW_AUDIO_STORAGE=true

# Google OAuth (Optional in dev - mock bypass active when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
RESTRICT_TO_DOMAINS=

# LTI 1.3 LMS Integration Config
LTI_KEY_ID=thinkfree-lti-key-1
